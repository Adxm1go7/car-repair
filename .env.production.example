# The live demo's settings. On the server: copy this to .env and fill in every value.
# Placeholders only: never commit the real .env. See docs/deployment.md.

# The public address Caddy gets an HTTPS certificate for (no https://, no slash).
SITE_ADDRESS=yourname.duckdns.org
# The same address as the site sees it: links in emails and the staff Origin check use it.
PUBLIC_BASE_URL=https://yourname.duckdns.org

# Production settings (Stripe required, rate limits on), plus the demo-site switch: the demo
# logins, the Demo inbox instead of sending email, and the 03:00 reset.
ENVIRONMENT=production
DEMO_SITE=true

# Database. Make the password with: openssl rand -base64 32
POSTGRES_USER=garage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=garage

# Stripe TEST mode keys only (dashboard.stripe.com/test/apikeys). Never live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# The signing secret of the webhook endpoint https://<SITE_ADDRESS>/api/stripe/webhook,
# made in the Stripe test dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# The sender name on emails (they're only shown in the Demo inbox).
SMTP_FROM=bookings@example.test
