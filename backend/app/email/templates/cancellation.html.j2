{% extends "_layout.html.j2" %}
{% block content %}
<p>Your booking with {{ c.garage.name }} on {{ when }} has been cancelled.</p>
{% endblock %}
{% block after %}
{% if c.deposit_status in ("refund_pending", "refunded") %}
<p>Your {{ deposit }} deposit is being refunded. It can take 5 to 10 working days to reach your account.</p>
{% elif c.deposit_status == "refund_failed" %}
<p>We'll be in touch about your refund.</p>
{% elif c.deposit_status == "paid" %}
<p>Your deposit has been kept, as the booking was cancelled less than {{ notice_hours }} hours before.</p>
{% endif %}
<p>To book again, please call us on {{ c.garage.phone }}.</p>
{% endblock %}
