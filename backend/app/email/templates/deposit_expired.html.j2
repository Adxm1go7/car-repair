{% extends "_layout.html.j2" %}
{% block content %}
<p>The deposit for your booking with {{ c.garage.name }} wasn't paid in time, so the time we were keeping for you has been released.</p>
{% endblock %}
{% block after %}
{% if c.deposit_status in ("refund_pending", "refunded", "refund_failed") %}
<p>Your {{ deposit_due }} payment came in after the time was released, so we're refunding it. It can take 5 to 10 working days to reach your account. If you'd still like to book, please call us on {{ c.garage.phone }}.</p>
{% else %}
<p>Nothing has been charged. If you'd still like to book, please call us on {{ c.garage.phone }}.</p>
{% endif %}
{% endblock %}
