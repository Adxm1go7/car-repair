# Copy to .env to override the defaults in docker-compose.yml.
# All values below are for local development only. Never use them in production.

# PostgreSQL superuser and database created on first start of the db container.
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage
POSTGRES_DB=garage

# development | test | production
ENVIRONMENT=development

# The API's DATABASE_URL is built from the POSTGRES_* values above in docker-compose.yml.
# When running the API outside Docker, set it yourself, e.g.:
# DATABASE_URL=postgresql+psycopg://garage:garage@localhost:5433/garage

# How often the worker releases expired slot holds, in seconds (at least 1).
# WORKER_INTERVAL_SECONDS=60

# Mail (Mailpit in development). Not read by the app until Milestone 6.
SMTP_HOST=mailpit
SMTP_PORT=1025
